# ==========================================
# ⚙️ SYSTEM SETTINGS
# ==========================================
ENV_NAME=staging_or_production
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com

# ==========================================
# 🐘 BACKEND (PostgreSQL & Security)
# ==========================================
# รูปแบบ: postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB_NAME]
DATABASE_URL=postgresql://db_user:db_password@staging_infra_db:5432/classroom_db

POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=classroom_db

# สุ่มตัวอักษรเพื่อใช้เป็น Key ของระบบ
API_KEY=your_random_api_key_here
SECRET_KEY=your_random_secret_key_here
SUPER_ADMIN_ID=1234567890

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

REDIS_URL: str = "redis://staging_infra_redis:6379/0"

# ==========================================
# 🌐 FRONTEND (Vue / Vite)
# ==========================================
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_DISCORD_CLIENT_ID=your_discord_client_id
VITE_DISCORD_REDIRECT_URI=https://app.yourdomain.com/auth/discord/callback

VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://app.yourdomain.com/auth/google/callback

# ==========================================
# 🤖 DISCORD BOT & OAUTH SETTINGS
# ==========================================
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://app.yourdomain.com/auth/discord/callback

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://app.yourdomain.com/auth/google/callback

DISCORD_TOKEN=your_discord_bot_token_here
API_BASE_URL=http://staging_app_backend:8000/api/classroom

# ==========================================
# 🤖 DISCORD BOT INVITE URL (OAuth2)
# ==========================================
# ลิงก์สำหรับเชิญบอทเข้าเซิร์ฟเวอร์ (ต้องเปิดใช้งาน OAuth2 ใน Discord Developer Portal)
VITE_DISCORD_BOT_INVITE_URL=https://discord.com/api/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=8&scope=bot%20applications.commands
